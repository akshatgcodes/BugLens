# Password for the app. Required.
APP_PASSWORD=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Where the React app runs (CORS)
FRONTEND_URL=http://localhost:5173

# Language model: groq, openai or ollama (all spoken to through the OpenAI-compatible API).
# Without a key BugLens still runs the static rules; the AI review is skipped.
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides; each provider has a default
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=

# Size limit per analysis, and how many issues the model may report
MAX_CHARS=40000
MAX_AI_ISSUES=15

# SQLite lives here
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/buglens
